<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- El generador de Excel arma el libro en memoria con zipstream y se
             pasa de los 128 MB que trae PHP por defecto en consola. No es una
             fuga: son varias hojas de detalle a la vez. Sin esto la suite falla
             de forma intermitente, según cuántos datos tenga el caso. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Sin esto las pruebas tomaban `BROADCAST_CONNECTION` del `.env`,
             que apunta a Reverb: cada evento intentaba una llamada HTTP a
             localhost:8080. Fallaba rapido cuando no habia nada escuchando y
             se tragaba el `try/catch`, asi que no se notaba; pero el
             resultado dependia de si quien corre las pruebas tiene Reverb
             levantado. -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!--
            El presupuesto de tiempo en base de datos, apagado en las pruebas.

            No es por ruido: es que «por peticion» no significa nada en un
            proceso de pruebas. El contador acumulado no se reinicia entre una
            prueba y la siguiente —eso lo hace Octane, y aqui no hay Octane—,
            asi que la suma crece durante todo el archivo y el aviso acabaria
            saltando por el montaje de la prueba numero cuarenta, apuntando a
            una ruta que no tiene nada que ver. Medido: una sola prueba llega a
            248 ms de acumulado.

            Las pruebas que SI lo ejercitan lo encienden ellas, con su
            presupuesto y reiniciando el contador antes
            (PresupuestoDeConsultasTest).
        -->
        <env name="DB_PRESUPUESTO_MS" value="0"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            LAS PRUEBAS NO USAN LAS CREDENCIALES DE LA MAQUINA.

            Sin esto, las que comprueban "sin transporte configurado lo DICE en
            vez de fingir" pasaban en un portatil sin credenciales y fallaban en
            cuanto alguien ponia las de verdad en su .env — que fue exactamente
            lo que paso al configurar Firebase. Una prueba que depende de la
            maquina no prueba nada.

            La que necesita el transporte encendido lo enciende ella misma con
            `config([...])`, que es explicito y no se lleva por delante al resto.
        -->
        <env name="FCM_PROJECT_ID" value=""/>
        <env name="FCM_CREDENTIALS_JSON" value=""/>
        <env name="FCM_CREDENTIALS" value=""/>
        <env name="APNS_KEY" value=""/>
        <env name="APNS_KEY_PATH" value=""/>
        <env name="APNS_KEY_ID" value=""/>
        <env name="APNS_TEAM_ID" value=""/>
        <env name="APNS_BUNDLE_ID" value=""/>
    </php>
</phpunit>
