APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
PANEL_URL=http://127.0.0.1:5174
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BOLD_BASE_URL=https://integrations.api.bold.co
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# --- Cloudflare R2 (medios de negocios) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=vecipaya-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Acuerdo de vinculación del domiciliario ---
# Datos de la empresa que se imprimen en el PDF del acuerdo. Los que lleven
# espacios VAN ENTRE COMILLAS: dotenv no admite valores sin comillar con
# espacios y el servidor se niega a arrancar.
CONTRATO_EMPRESA="MARCAVA GROUP S.A.S."
CONTRATO_NIT=
CONTRATO_REPRESENTANTE="Nombre del representante legal"
CONTRATO_REPRESENTANTE_CC=
CONTRATO_CIUDAD=Barranquilla

# ---------------------------------------------------------------------------
# MONITOREO DE ERRORES (opcional)
#
# Sin DSN el paquete queda inerte: no captura, no envía y no cuesta nada. Con
# DSN, un 500 en producción se sabe en el momento en vez de cuando un usuario
# se toma la molestia de contarlo.
#
# `TRACES_SAMPLE_RATE` en 0 desactiva el trazado de rendimiento, que es lo que
# consume cuota. Se sube cuando haga falta perseguir una consulta lenta.
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# ---------------------------------------------------------------------------
# COPIAS DE SEGURIDAD
#
# `local` deja la copia en storage/app: sirve para probar y NO protege de
# perder el servidor. En producción, `r2` — el mismo bucket que el resto de
# archivos.
# ---------------------------------------------------------------------------
BACKUP_DISK=local

# Carpeta de `mysqldump`. Vacío si está en el PATH (lo normal en Linux). En
# Windows casi nunca lo está y sin esto la copia falla con un error que no
# menciona la copia.
DB_DUMP_BINARY_PATH=
