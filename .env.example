APP_NAME="VeciPa'Ya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
PANEL_URL=http://127.0.0.1:5174
# El panel de aliados —tenderos y conjuntos— vive en su propio subdominio y
# es otro origen para el navegador. En produccion: https://aliados.<dominio>
ALIADOS_URL=http://127.0.0.1:5177
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Clave de los usuarios que crea UsersSeeder (admin@gmail.com y los de prueba).
# Solo para desarrollo. Si se deja vacía, el seeder genera una al azar y la
# imprime una vez: eso es lo correcto en cualquier servidor de verdad, porque una
# clave escrita en el repositorio es una clave publicada.
SEED_PASSWORD=

# Los seeders de prueba y de demostración se niegan a correr con APP_ENV
# production. Ponerlo en true es decir "sé que estoy creando usuarios falsos con
# clave conocida en el servidor de verdad".
SEED_ALLOW_PRODUCTION=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `reverb` en el servidor; `log` en local si no se quiere levantar el websocket.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BOLD_BASE_URL=https://integrations.api.bold.co
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# --- Cloudflare R2 (medios de negocios) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=vecipaya-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Acuerdo de vinculación del domiciliario ---
# Datos de la empresa que se imprimen en el PDF del acuerdo. Los que lleven
# espacios VAN ENTRE COMILLAS: dotenv no admite valores sin comillar con
# espacios y el servidor se niega a arrancar.
CONTRATO_EMPRESA="MARCAVA GROUP S.A.S."
CONTRATO_NIT=
CONTRATO_REPRESENTANTE="Nombre del representante legal"
CONTRATO_REPRESENTANTE_CC=
CONTRATO_CIUDAD=Barranquilla

# ---------------------------------------------------------------------------
# MONITOREO DE ERRORES (opcional)
#
# Sin DSN el paquete queda inerte: no captura, no envía y no cuesta nada. Con
# DSN, un 500 en producción se sabe en el momento en vez de cuando un usuario
# se toma la molestia de contarlo.
#
# `TRACES_SAMPLE_RATE` en 0 desactiva el trazado de rendimiento, que es lo que
# consume cuota. Se sube cuando haga falta perseguir una consulta lenta.
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# ---------------------------------------------------------------------------
# COPIAS DE SEGURIDAD
#
# `local` deja la copia en storage/app: sirve para probar y NO protege de
# perder el servidor. En producción, `r2` — el mismo bucket que el resto de
# archivos.
# ---------------------------------------------------------------------------
# `r2_respaldos` en el servidor: es un bucket APARTE y sin dominio público.
# NO poner `r2` acá — ese bucket es el de las imágenes y se lee desde internet,
# así que la copia de la base quedaría descargable por cualquiera.
BACKUP_DISK=local

# Carpeta de `mysqldump`. Vacío si está en el PATH (lo normal en Linux). En
# Windows casi nunca lo está y sin esto la copia falla con un error que no
# menciona la copia.
DB_DUMP_BINARY_PATH=

# Notificaciones a los teléfonos (Firebase Cloud Messaging, HTTP v1).
# Sin esto el módulo de Notificaciones funciona pero NO entrega nada, y la
# pantalla lo dice. La ruta apunta al JSON de la cuenta de servicio que da
# Firebase; va fuera del repositorio, porque permite mandarle una notificación a
# cualquier usuario de la plataforma.
# La cuenta de servicio de Firebase. NUNCA en el repositorio: da acceso de
# administrador al proyecto. Con despliegue desde GitHub, usa la variable de
# abajo (el JSON en base64, que es una sola linea).
FCM_CREDENTIALS=
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# ---------------------------------------------------------------------------
# WEBSOCKETS (Laravel Reverb)
#
# Sin esto el seguimiento del pedido no avanza solo en el teléfono: el estado
# cambia en la base y nadie se entera hasta que la app recarga.
#
# OJO con la diferencia entre estas dos cosas, que es la que más confunde:
#
#   · REVERB_HOST / PORT / SCHEME es a dónde PUBLICA el servidor. En Docker es
#     el nombre del servicio dentro de la red —`reverb`, puerto 8080, http— y
#     no el dominio público: publicar contra el dominio obliga a salir a
#     internet y volver a entrar por el proxy para nada.
#
#   · El dominio público (wss://ws.tudominio.com) lo usa la APP MÓVIL, y vive
#     en sus propias constantes, no acá.
#
# APP_ID, KEY y SECRET los comparten servidor y app. La KEY es pública —va
# dentro del cliente— pero el SECRET no: con él se puede publicar en cualquier
# canal.
# ---------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Dónde escucha el proceso de Reverb dentro del contenedor. No se toca.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# DESPLIEGUE
#
# En el servidor estas variables NO salen de un archivo: las inyecta Dokploy en
# el entorno de cada servicio. Dentro de la imagen no hay ningún .env, a
# propósito (ver .dockerignore).
#
# Lo mínimo que hay que poner allá, además de lo de arriba:
#
#   APP_ENV=production        APP_DEBUG=false
#   APP_KEY=                  (php artisan key:generate --show)
#   APP_URL=https://api.tudominio.com
#   PANEL_URL=https://panel.tudominio.com
#   DB_CONNECTION=mysql       DB_DATABASE=... DB_USERNAME=... DB_PASSWORD=...
#   DB_HOST=                  el nombre INTERNO del servicio de base de datos.
#                             NUNCA la IP pública del propio servidor: un
#                             contenedor no puede salir y volver a entrar por
#                             ella, y la API se queda esperando para siempre.
#   CACHE_STORE=database      QUEUE_CONNECTION=database   SESSION_DRIVER=database
#   BROADCAST_CONNECTION=reverb
#   BACKUP_DISK=r2            (dejarlo en `local` no protege de perder el VPS)
#   SEED_PASSWORD=            (vacío: una clave escrita es una clave publicada)
# ---------------------------------------------------------------------------

# =============================================================================
# ORÍGENES AUTORIZADOS PARA LLAMAR A LA API DESDE UN NAVEGADOR (CORS)
# =============================================================================
# Lista separada por comas. Hasta ahora estaba escrita a mano en
# config/cors.php con una sola URL, así que autorizar un dominio obligaba a
# tocar código y desplegar.
#
# NO admite '*': con supports_credentials activo el navegador rechaza el
# comodín, y hay que nombrar cada origen. Vacío = los puertos de desarrollo
# del monorepo (5173-5177: panel, landing y aliados).
#
# A esta lista se le suman siempre, sin escribirlos acá, los dominios que la
# aplicación ya tiene configurados: SITIO_URL (y su `www`), PANEL_URL,
# ALIADOS_URL y APP_URL. Ver config/cors.php.
#
# CUIDADO CON DEJAR UN SOLO ORIGEN. Con exactamente uno permitido y ningún
# patrón, la librería de CORS devuelve ESE origen en la cabecera sin mirar
# quién preguntó: producción tenía sólo el panel y la web pública recibía
# `Access-Control-Allow-Origin: https://panel...`, así que el navegador
# bloqueaba todas las llamadas de /cobertura.
#
#   CORS_ALLOWED_ORIGINS=https://enviaya.com.co,https://www.enviaya.com.co,https://panel.enviaya.com.co,https://admin.enviaya.com.co
CORS_ALLOWED_ORIGINS=

# Expresiones regulares CON delimitadores, para despliegues de vista previa
# con un subdominio por rama, o para autorizar de una vez todos los
# subdominios del dominio propio —presentes y futuros—:
#
#   CORS_ALLOWED_ORIGIN_PATTERNS=~^https://([a-z0-9-]+\.)*enviaya\.com\.co$~i
#
# El delimitador es `~` y no `/` para no tener que escapar las barras de la
# URL. El `$` del final no es decoración: sin él, `enviaya.com.co.otro.com`
# también pasaría. Se separan por comas, así que el patrón no puede llevar
# comas ni cuantificadores como `{2,3}`.
#
# Vacío por defecto: un patrón mal escrito abre más de lo que pretende.
CORS_ALLOWED_ORIGIN_PATTERNS=

# -----------------------------------------------------------------------------
# WEB PÚBLICA
# -----------------------------------------------------------------------------
# A dónde manda el backend al usuario y qué logotipo pinta en los correos.
# De acá sale la redirección posterior a confirmar el correo, así que tiene que
# ser un dominio que responda: apuntó durante meses a vecipaya.com, que dejó de
# hacerlo, y la confirmación terminaba en una página de error.
SITIO_URL=https://enviaya.com.co
# El buzón sigue en vecipaya.com a propósito: ese dominio tiene MX activos y
# enviaya.com.co todavía no. Ver el comentario en config/services.php.
SITIO_CORREO=gerencia@vecipaya.com
SITIO_CORREO_SOPORTE=gerencia@vecipaya.com


# =============================================================================
# MAPA DE COBERTURA DE LA WEB PÚBLICA
# =============================================================================
# `GET /v1/cobertura-free` publica la ubicación de los comercios y de los
# conjuntos conectados, para que la landing pueda dibujarlos.
#
# La de un conjunto dice dónde vive gente. Poner esto en false deja el mapa
# solo con los comercios, sin tocar código.
COBERTURA_INCLUIR_CONJUNTOS=true
