*.log
.DS_Store
.env
.env.backup
# Cualquier .env con otro sufijo: se usan para apuntar comandos a otra base
# —por ejemplo `--env=produccion`— y llevan credenciales de verdad.
.env.*
!.env.example
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Credenciales de cuentas de servicio de Google/Firebase.
#
# Su clave privada da acceso de administrador al proyecto, y este repositorio
# es publico. Se ignoran por patron y no por nombre exacto porque el archivo
# que descarga Firebase trae un nombre distinto cada vez
# (`<proyecto>-firebase-adminsdk-<hash>.json`), asi que confiar en recordarlo
# es confiar en no equivocarse nunca.
*firebase-adminsdk*.json
*-service-account*.json
service-account*.json
/storage/app/firebase/

# Credenciales de firma y notificaciones. Ninguna de estas va al repositorio:
# con la .p8 de APNs se pueden mandar notificaciones en nombre de la app, y
# Apple la entrega UNA sola vez.
*.p8
*.p12
*.mobileprovision
AuthKey_*
